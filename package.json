{
  "name": "colombia-kit",
  "version": "0.2.1",
  "description": "Festivos de Colombia, días hábiles, NIT (DIAN), pesos COP y códigos DANE. Colombian holidays, business days, NIT check digit, COP formatting. Zero dependencies.",
  "keywords": [
    "colombia",
    "festivos",
    "holidays",
    "dias-habiles",
    "business-days",
    "nit",
    "dian",
    "cop",
    "dane",
    "divipola",
    "festivos-colombia",
    "dias-festivos",
    "feriados",
    "ley-emiliani",
    "digito-verificacion",
    "nit-colombia",
    "pesos-colombianos",
    "cedula",
    "departamentos",
    "colombian-holidays",
    "typescript"
  ],
  "author": "Esneider Mejía Ciro (https://github.com/emejiac)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emejiac/colombia-kit.git"
  },
  "homepage": "https://github.com/emejiac/colombia-kit#readme",
  "bugs": {
    "url": "https://github.com/emejiac/colombia-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run format:check && npm run test:tz && npm run build",
    "test:tz": "TZ=America/Bogota vitest run && TZ=Asia/Tokyo vitest run && TZ=UTC vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
